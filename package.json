{
  "name": "edgegoat",
  "version": "0.1.0",
  "description": "Edge case test inputs for JavaScript and TypeScript: time zones, daylight saving time, dates before 1970, unicode test strings, -0, NaN, URLs, paths and JSON, ready for Vitest, Jest, node:test and Mocha.",
  "keywords": [
    "edge cases",
    "edge case testing",
    "javascript edge cases",
    "test timezone javascript",
    "timezone testing",
    "time zones",
    "daylight saving time",
    "daylight saving time jest",
    "dst",
    "mock date",
    "mock date jest",
    "freeze time",
    "dates before 1970",
    "unicode test strings",
    "naughty strings",
    "surrogate pairs",
    "emoji",
    "negative zero",
    "nan",
    "number edge cases",
    "bigint",
    "property based testing",
    "test data",
    "test cases",
    "test.each",
    "jest",
    "vitest",
    "node test",
    "mocha",
    "typescript"
  ],
  "homepage": "https://kwy404.github.io/edgegoat/",
  "bugs": {
    "url": "https://github.com/kwy404/edgegoat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/edgegoat.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run build",
    "test:watch": "vitest",
    "examples:node-test": "node --test examples/node-test/edge-cases.test.mjs",
    "docs:catalog": "npm run build && node scripts/build-catalog.mjs",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
