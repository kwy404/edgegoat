{
  "name": "edgegoat",
  "version": "1.0.0",
  "description": "Curated edge case inputs for JavaScript tests, each with the reason it breaks code.",
  "keywords": [
    "edge cases",
    "testing",
    "test data",
    "time zones",
    "daylight saving time",
    "unicode",
    "test.each",
    "typescript"
  ],
  "homepage": "https://kwy404.github.io/edgegoat/",
  "bugs": {
    "url": "https://github.com/kwy404/edgegoat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/edgegoat.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run build",
    "test:watch": "vitest",
    "examples:node-test": "node --test examples/node-test/edge-cases.test.mjs",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build && npm test",
    "docs": "npm run build && node scripts/build-assets.mjs && node scripts/season-art.mjs && node scripts/build-docs.mjs",
    "docs:highlight": "node scripts/highlight-docs.mjs",
    "docs:seasons": "node scripts/season-art.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "shiki": "^4.5.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
